# .env.example
APP_ENV=development            # production দিলে নিচের ADMIN_API_KEY বদলানো বাধ্যতামূলক

OPENAI_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=

# Admin key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me

EMBEDDING_MODEL=               # বদলালে Pinecone index-এর dimension মিলতে হবে
INDEX_READY_TIMEOUT_SECONDS=120

# --- Multi-user foundation (docs/backend-design.md) ---
# Postgres dev container (docker compose). POSTGRES_PASSWORD is REQUIRED:
# compose refuses to start the db/app/test services without it (no silent
# fallback). Pick your own value in .env — these are placeholders.
# If you override the defaults, update DATABASE_URL / TEST_DATABASE_URL to
# match, and remember the pgdata volume only applies POSTGRES_PASSWORD on
# FIRST init (else ALTER USER inside the running db). A password containing
# URL-special characters (:@/?#...) must be %-encoded inside DATABASE_URL.
# Production never uses this compose file; it gets DATABASE_URL only.
#POSTGRES_USER=rag
#POSTGRES_PASSWORD=change-me-locally
#POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag          # inside compose network; the dev DB has NO host port (see docker-compose.yml)
TEST_DATABASE_URL=             # set automatically inside `docker compose --profile test run --rm test`
COOKIE_SECURE=true             # false ONLY for local development over plain http
SESSION_IDLE_HOURS=168         # 7 days sliding
SESSION_ABSOLUTE_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10 # per-IP sliding window on POST /api/auth/login (0 = off)
# Pepper for the login-throttle counters (usernames stored only as
# sha256(pepper + username)). Empty = fixed dev fallback + startup warning.
# REQUIRED for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOGIN_THROTTLE_PEPPER=
#RUN_MIGRATIONS_ON_STARTUP=true # compose app sets this; production keeps the documented `alembic upgrade` deploy step
ENABLE_WEB_FALLBACK=true       # false = query text never leaves for Tavily
MAX_UPLOAD_MB=25
CONVERSATION_RETENTION_DAYS=0  # 0 = keep until the user deletes (sweep deferred)
PINECONE_TEST_NAMESPACE=multi-user-test

# Keep false: 'true' sends every question, retrieved chunk, and answer to
# LangSmith's cloud (third party). Enable only in staging with synthetic data.
LANGSMITH_TRACING=false